# =============================================================================
# Multi-stage Dockerfile for Celery Workers
# =============================================================================
# This Dockerfile is optimized for running Celery workers and beat scheduler
# It shares the same base as the main backend but with Celery-specific configuration

# =============================================================================
# Stage 1: Base Image
# =============================================================================
FROM python:3.11-slim as base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    C_FORCE_ROOT=true

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # PostgreSQL client
    postgresql-client \
    # Required for some Python packages
    gcc \
    g++ \
    libpq-dev \
    # For image processing (Pillow)
    libjpeg-dev \
    zlib1g-dev \
    # For OCR (Tesseract)
    tesseract-ocr \
    tesseract-ocr-eng \
    # For PDF processing
    poppler-utils \
    # For email processing
    libmagic1 \
    # Utilities
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r celeryuser && useradd -r -g celeryuser celeryuser

# Set working directory
WORKDIR /app

# =============================================================================
# Stage 2: Dependencies
# =============================================================================
FROM base as dependencies

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# =============================================================================
# Stage 3: Development
# =============================================================================
FROM dependencies as development

# Install development dependencies
COPY requirements-dev.txt* ./
RUN if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi

# Copy application code
COPY . .

# Change ownership to non-root user
RUN chown -R celeryuser:celeryuser /app

# Switch to non-root user
USER celeryuser

# Default command (can be overridden in docker-compose)
CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=info"]

# =============================================================================
# Stage 4: Production
# =============================================================================
FROM dependencies as production

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs /app/celerybeat-schedule && \
    chown -R celeryuser:celeryuser /app

# Switch to non-root user
USER celeryuser

# Default command (can be overridden in docker-compose)
CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=info", "--concurrency=4"]

