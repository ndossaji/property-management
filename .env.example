# =============================================================================
# PROPERTY MANAGEMENT APPLICATION - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
POSTGRES_DB=propertymgmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-use-strong-password
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=changeme-use-strong-password
REDIS_PORT=6379

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
BACKEND_PORT=8000
SECRET_KEY=changeme-generate-secure-random-key-min-32-chars
JWT_SECRET=changeme-generate-secure-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost/api

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# AUTHENTICATION (Auth0 or AWS Cognito)
# =============================================================================
AUTH_PROVIDER=auth0

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# AWS Cognito Configuration (alternative to Auth0)
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=your-client-id
# COGNITO_CLIENT_SECRET=your-client-secret
# COGNITO_REGION=us-east-1

# =============================================================================
# AWS S3 CONFIGURATION (for file storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=propertymgmt-uploads

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=Property Management

# AWS SES Configuration (alternative to SMTP)
# SES_REGION=us-east-1
# SES_FROM_EMAIL=noreply@yourcompany.com

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL=redis://:changeme-use-strong-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme-use-strong-password@redis:6379/2

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost,https://yourdomain.com

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Plaid (for bank/credit card integration)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# OCR Services (AWS Textract or Tesseract)
TEXTRACT_ENABLED=false
TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-optional

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Session settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# DEVELOPMENT SETTINGS (only for local development)
# =============================================================================
# Uncomment these for local development
# APP_ENV=development
# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000

